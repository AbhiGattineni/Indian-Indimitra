# Copy this file to ".env" and fill in your Firebase project's web-app config.
# Firebase console -> Project settings -> General -> Your apps -> Web app -> SDK setup and configuration.
# All keys must start with VITE_ to be exposed to the client (Vite convention).

VITE_FIREBASE_API_KEY=your-api-key
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=000000000000
VITE_FIREBASE_APP_ID=1:000000000000:web:abcdef123456

# NOTE: order-notification emails are sent SERVER-SIDE by a Cloud Function
# (see functions/). No email credentials belong in the client.
