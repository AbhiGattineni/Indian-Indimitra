rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Product & store images: public read; authenticated write.
    match /products/{storeId}/{fileName} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    match /stores/{storeId}/{fileName} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    match /{allPaths=**} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;
    }
  }
}
